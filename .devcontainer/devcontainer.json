{
  "name": "OnaFlix Data Pipeline",
  "image": "mcr.microsoft.com/devcontainers/go:1.21",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers-extra/features/postgresql-client:1": {}
  },
  "forwardPorts": [5432],
  "postCreateCommand": "go mod download",
  "containerEnv": {
    "DATABASE_URL": "postgres://gitpod:gitpod@localhost:5432/onaflix?sslmode=disable"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  }
}
